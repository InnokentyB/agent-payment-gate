FROM rust:1.93.0-bookworm@sha256:d0a4aa3ca2e1088ac0c81690914a0d810f2eee188197034edf366ed010a2b382
RUN apt-get update && apt-get install -y --no-install-recommends libdbus-1-3 libudev1 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32v1-none && rustup component add rustfmt && useradd --uid 1000 --create-home builder
RUN curl -fsSL https://github.com/stellar/stellar-cli/releases/download/v25.2.0/stellar-cli-25.2.0-x86_64-unknown-linux-gnu.tar.gz -o /tmp/stellar.tar.gz \
 && echo 'da809a7b6ec3e66a5dd6ebdf199cdd638007bd5c063bfd6d18ae63a18b1b86b6  /tmp/stellar.tar.gz' | sha256sum -c - \
 && tar -xzf /tmp/stellar.tar.gz -C /usr/local/bin stellar && rm /tmp/stellar.tar.gz \
 && stellar --version
ENV CARGO_HOME=/home/builder/.cargo CARGO_TARGET_DIR=/workspace/contracts/target CARGO_BUILD_JOBS=2
RUN mkdir -p /home/builder/.cargo && chown -R builder:builder /home/builder
USER builder
WORKDIR /workspace/contracts
CMD ["cargo", "test", "--locked", "--", "--test-threads=1"]
